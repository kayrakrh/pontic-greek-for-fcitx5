(input-method pnt greek)
(description "Pontic Greek keyboard")
(title "Ποντ")
 (trans
  ;; --- base letters ---
  ("a" "α")
  ("b" "β")
  ("g" "γ")
  ("d" "δ")
  ("e" "ε")
  ("z" "ζ")
  ("h" "η")
  ("u" "θ")
  ("i" "ι")
  ("k" "κ")
  ("l" "λ")
  ("m" "μ")
  ("n" "ν")
  ("j" "ξ")
  ("o" "ο")
  ("p" "π")
  ("r" "ρ")
  ("s" "σ")
  ("w" "ς")
  ("t" "τ")
  ("y" "υ")
  ("f" "φ")
  ("x" "χ")
  ("c" "ψ")
  ("v" "ω")
  ("A" "Α")
  ("B" "Β")
  ("G" "Γ")
  ("D" "Δ")
  ("E" "Ε")
  ("Z" "Ζ")
  ("H" "Η")
  ("U" "Θ")
  ("I" "Ι")
  ("K" "Κ")
  ("L" "Λ")
  ("M" "Μ")
  ("N" "Ν")
  ("J" "Ξ")
  ("O" "Ο")
  ("P" "Π")
  ("R" "Ρ")
  ("S" "Σ")
  ("T" "Τ")
  ("Y" "Υ")
  ("F" "Φ")
  ("X" "Χ")
  ("C" "Ψ")
  ("V" "Ω")
  ("W" "Σ")
  ("q" ";")
  ("Q" ":")
  ;; TONOS
  (";" ";")
  (";a" "ά")
  (";e" "έ")
  (";h" "ή")
  (";i" "ί")
  (";o" "ό")
  (";y" "ύ")
  (";v" "ώ")
  (";A" "Ά")
  (";E" "Έ")
  (";H" "Ή")
  (";I" "Ί")
  (";O" "Ό")
  (";Y" "Ύ")
  (";V" "Ώ")
  ;; --- dialytika / Pontic α̈ ο̈: : + vowel ---
  (":" ":")
  (":i" "ϊ")
  (":y" "ϋ")
  (":I" "Ϊ")
  (":Y" "Ϋ")
  (":a" "α̈")
  (":o" "ο̈")
  (":A" "Α̈")
  (":O" "Ο̈")
  ;; --- Pontic carons σ̌ ζ̌ ξ̌ ψ̌ : ^ or ` or < + letter ---
  ("^" "^")
  ("^s" "σ̌")
  ("^z" "ζ̌")
  ("^j" "ξ̌")
  ("^c" "ψ̌")
  ("^S" "Σ̌")
  ("^Z" "Ζ̌")
  ("^J" "Ξ̌")
  ("^C" "Ψ̌")
  ("`" "`")
  ("`s" "σ̌")
  ("`z" "ζ̌")
  ("`j" "ξ̌")
  ("`c" "ψ̌")
  ("`S" "Σ̌")
  ("`Z" "Ζ̌")
  ("`J" "Ξ̌")
  ("`C" "Ψ̌")
  ("<" "<")
  ("<s" "σ̌")
  ("<z" "ζ̌")
  ("<j" "ξ̌")
  ("<c" "ψ̌")
  ("<S" "Σ̌")
  ("<Z" "Ζ̌")
  ("<J" "Ξ̌")
  ("<C" "Ψ̌")
  ))
(state
 (init (trans)))
